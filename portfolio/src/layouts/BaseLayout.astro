---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Lawrence Chew` : 'Lawrence Chew'}</title>
    <meta name="description" content={description ?? 'Platform Engineer · DevSecOps · Cloud Engineer'} />
    <link rel="stylesheet" href="/src/styles/global.css">
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/" aria-label="Home"><strong>Lawrence Chew</strong></a>
        <div class="muted">Platform Engineer · DevSecOps · Cloud Engineer</div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      <div class="container muted">© Lawrence Chew — <a href="/resume">Resume</a> · <a href="https://github.com/Lawrencechew">GitHub</a> · <a href="https://linkedin.com/in/lawrencechewzx">LinkedIn</a></div>
    </footer>
  </body>
</html>
