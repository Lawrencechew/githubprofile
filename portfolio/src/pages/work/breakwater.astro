---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectBySlug } from "../../data/projects";

const project = getProjectBySlug("breakwater");

if (!project) {
  throw new Error("Breakwater project data not found.");
}
---
<BaseLayout title={`${project.title} — ${project.subtitle}`} description={project.summary} canonicalPath="/work/breakwater/">
  <h1>{project.title}</h1>
  <p class="muted">{project.subtitle}</p>
  <p>{project.summary}</p>

  <section class="section">
    <h2>Overview</h2>
    <p>{project.positioning}</p>
  </section>

  <section class="section">
    <h2>Problem</h2>
    <p>{project.problem}</p>
  </section>

  <section class="section">
    <h2>Engineering Goals</h2>
    <ul>{project.engineeringGoals.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="section">
    <h2>Architecture</h2>
    <ul>{project.architecture.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="section">
    <h2>Key Engineering Decisions</h2>
    <ul>{project.keyEngineeringDecisions.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="section">
    <h2>Security / Reliability Controls</h2>
    <ul>{project.controls.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="section">
    <h2>Validation / Testing</h2>
    <ul>{project.validation.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="section">
    <h2>What This Demonstrates</h2>
    <ul>{project.demonstrates.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="section card">
    <h2>Repository / Demo</h2>
    <p>
      <a href={project.repositoryUrl}>{project.repositoryLabel}</a>
    </p>
    <p class="muted">Live cloud validation (AKS/Argo/Workload Identity runtime proof) depends on environment access and is tracked separately.</p>
  </section>
</BaseLayout>
