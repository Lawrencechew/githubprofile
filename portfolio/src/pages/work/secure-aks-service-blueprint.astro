---
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const breakwaterPath = `${baseUrl}work/breakwater`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${breakwaterPath}`} />
    <title>Redirecting to Breakwater</title>
    <link rel="canonical" href={breakwaterPath} />
  </head>
  <body>
    <p>This project has been renamed. Continue to <a href={breakwaterPath}>Breakwater</a>.</p>
  </body>
</html>
