---
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentRoles, earlierExperience } from "../data/experience";
---
<BaseLayout title="Experience" description="Career progression across platform engineering, DevSecOps and cloud-native systems." canonicalPath="/experience/">
  <h1>Experience</h1>
  <p class="muted">Maritime and Port Authority of Singapore · Jun 2021 - Present</p>

  <section class="section grid">
    {currentRoles.map((role) => (
      <article class="card">
        <h2>{role.role}</h2>
        <p class="muted">{role.organisation} · {role.period}</p>
        <ul>{role.highlights.map((item) => <li>{item}</li>)}</ul>
      </article>
    ))}
  </section>

  <section class="section">
    <h2>Earlier Experience</h2>
    <div class="grid">
      {earlierExperience.map((role) => (
        <article class="card">
          <h3>{role.role}</h3>
          <p class="muted">{role.organisation}</p>
          <ul>{role.highlights.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
